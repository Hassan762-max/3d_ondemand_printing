# Environment
DATABASE_URL="file:./dev.db"
# Production: postgresql://USER:PASS@HOST:5432/nivaro?sslmode=require
AUTH_SECRET="replace-with-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nivaro"
NEXT_PUBLIC_ADVANCE_AMOUNT="500"

AI_PROVIDER="live-ready"
# Future: openai | replicate | fal (+ corresponding API keys)

PAYMENT_PROVIDER="cod_hybrid"
# Options: cod_hybrid | jazzcash | easypaisa | online
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# EASYPAISA_STORE_ID=
# EASYPAISA_PASSWORD=

STORAGE_PROVIDER="local"
# Future: s3 | r2 (requires object storage credentials)

NOTIFY_PROVIDER="console"
# Options: console | noop — email/SMS providers later
