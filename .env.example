# =============================================================================
# Nivaro / Printora — environment template
# Copy to `.env` for local development. Never commit real secrets.
# Production deploys: set APP_ENV=production and supply values via a secret manager.
# =============================================================================

# --- Core ---
# development | staging | production (use production only on live deploys)
# APP_ENV="development"
DATABASE_URL="file:./dev.db"
# Production: postgresql://USER:PASS@HOST:5432/nivaro?sslmode=require

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="<GENERATE_SECURE_SECRET_MIN_32_CHARS>"
# Local: http://localhost:3000  |  Production: https://your-domain.tld
# Local Chrome / next dev: keep AUTH_URL on localhost so Auth.js does not use
# __Secure- cookies (those break when ngrok forwards as http://localhost).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Browser URL you open (ngrok .dev). Used for client banners / Capacitor only.
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nivaro"
# Pricing: blank apparel + Rs 100 per printed side (Front/Back) + flat Rs 250 delivery — no separate sticker fee (see src/lib/orders/pricing.ts)
# Legacy flag — ignored. Demo emails/passwords are never shown in the app UI.
# Do not set NEXT_PUBLIC_ALLOW_DEMO_CREDENTIALS (leave unset).

# --- Providers (stubs until live keys are wired) ---
AI_PROVIDER="live-ready"
# Future: openai | replicate | fal
# OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
# REPLICATE_API_TOKEN=<YOUR_REPLICATE_API_TOKEN>
# FAL_KEY=<YOUR_FAL_KEY>

PAYMENT_PROVIDER="cod_hybrid"
# Options: cod_hybrid | jazzcash | easypaisa | online
# JazzCash / Easypaisa stubs refuse COMPLETED captures when APP_ENV/NODE_ENV
# is production unless ALLOW_PAYMENT_STUB=true (drill only).
# JAZZCASH_MERCHANT_ID=<YOUR_JAZZCASH_MERCHANT_ID>
# JAZZCASH_PASSWORD=<YOUR_JAZZCASH_PASSWORD>
# EASYPAISA_STORE_ID=<YOUR_EASYPAISA_STORE_ID>
# EASYPAISA_PASSWORD=<YOUR_EASYPAISA_PASSWORD>
# ALLOW_PAYMENT_STUB="false"

STORAGE_PROVIDER="local"
# Future: s3 | r2
# S3_BUCKET=<YOUR_BUCKET>
# S3_ACCESS_KEY_ID=<YOUR_ACCESS_KEY>
# S3_SECRET_ACCESS_KEY=<YOUR_SECRET_KEY>
# S3_ENDPOINT=<OPTIONAL_R2_OR_CUSTOM_ENDPOINT>

NOTIFY_PROVIDER="console"
# Options: console | noop
# Future email/SMS providers will add their own secrets here.

# Android WebView / Capacitor — must match the URL the device opens
# CAPACITOR_SERVER_URL="https://xxxx.ngrok-free.app"
# When testing via ngrok in a browser, set AUTH_URL to that same https URL.
