generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DESIGNER
  VENDOR
  PRODUCTION_MANAGER
  QC_MANAGER
  SUPPORT_MANAGER
  FINANCE_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum ProductCategory {
  T_SHIRT
  OVERSIZED_T_SHIRT
  POLO
  HOODIE
  SWEATSHIRT
  CASUAL_SHIRT
  JACKET
  JOGGERS
  SHORTS
  CAP
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  ADVANCE_PAID
  ASSIGNED
  IN_PRODUCTION
  QC
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
  REPRINT
  REPLACEMENT
}

enum PaymentKind {
  ADVANCE
  COD_REMAINING
  DELIVERY_FEE
  REFUND
  VENDOR_SETTLEMENT
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AiJobType {
  ENHANCE
  DIAGNOSE
  GENERATE
  STYLE_CONSULT
  DESIGN_CONSULT
  TRY_ON
  TRY_ON_REVIEW
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  phone          String?
  image          String?
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  city           String?
  province       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  designs        Design[]           @relation("DesignOwner")
  savedDesigns   SavedDesign[]
  wishlistItems  WishlistItem[]
  cart           Cart?
  orders         Order[]
  reviews        Review[]
  styleProfile   StyleProfile?
  tryOnSessions  TryOnSession[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  vendorProfile  Vendor?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  category    ProductCategory
  basePrice   Int
  currency    String          @default("PKR")
  imageUrl    String?
  modelUrl    String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  variants    ProductVariant[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  size      String
  color     String
  colorHex  String
  stockNote String?
  active    Boolean @default(true)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Design {
  id           String   @id @default(cuid())
  ownerId      String?
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  isLibrary    Boolean  @default(false)
  tags         String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User?         @relation("DesignOwner", fields: [ownerId], references: [id])
  savedBy      SavedDesign[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  placements   DesignPlacement[]
  tryOns       TryOnSession[]
}

model DesignPlacement {
  id        String  @id @default(cuid())
  designId  String
  side      String  @default("front")
  x         Float   @default(0.5)
  y         Float   @default(0.4)
  scale     Float   @default(1)
  rotation  Float   @default(0)
  design    Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model SavedDesign {
  id        String   @id @default(cuid())
  userId    String
  designId  String
  name      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  productId       String
  designId        String?
  size            String
  color           String
  quantity        Int     @default(1)
  placementJson   String  @default("{}")
  unitPrice       Int
  cart            Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  design          Design? @relation(fields: [designId], references: [id])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotal        Int
  deliveryFee     Int         @default(0)
  advanceAmount   Int         @default(500)
  remainingAmount Int
  vendorCost      Int         @default(0)
  platformMargin  Int         @default(0)
  currency        String      @default("PKR")
  shippingName    String
  shippingPhone   String
  shippingCity    String
  shippingAddress String
  shippingProvince String?
  notes           String?
  vendorId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  items           OrderItem[]
  payments        PaymentLedger[]
  shipments       Shipment[]
  returns         ReturnRequest[]
  reviews         Review[]
  assignments     FulfillmentAssignment[]
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  designId      String?
  title         String
  size          String
  color         String
  quantity      Int
  unitPrice     Int
  placementJson String  @default("{}")
  printReadyUrl String?
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
  design        Design? @relation(fields: [designId], references: [id])
}

model PaymentLedger {
  id        String        @id @default(cuid())
  orderId   String
  kind      PaymentKind
  amount    Int
  status    PaymentStatus @default(PENDING)
  method    String        @default("COD_HYBRID")
  reference String?
  metaJson  String        @default("{}")
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Vendor {
  id               String   @id @default(cuid())
  userId           String   @unique
  businessName     String
  city             String
  province         String
  phone            String
  active           Boolean  @default(true)
  capacityDaily    Int      @default(50)
  baseCostFactor   Float    @default(1)
  qualityScore     Float    @default(4)
  cancelRate       Float    @default(0)
  returnRate       Float    @default(0)
  defectRate       Float    @default(0)
  qcFailRate       Float    @default(0)
  deliveryScore    Float    @default(4)
  rating           Float    @default(4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilities     VendorCapability[]
  orders           Order[]
  assignments      FulfillmentAssignment[]
}

model VendorCapability {
  id       String          @id @default(cuid())
  vendorId String
  category ProductCategory
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, category])
}

model FulfillmentAssignment {
  id         String   @id @default(cuid())
  orderId    String
  vendorId   String
  score      Float
  reasonJson String   @default("{}")
  assignedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  carrier        String?
  trackingNumber String?
  status         String    @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  reason    String
  status    String   @default("open")
  resolution String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StyleProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  preferences  String   @default("{}")
  sizes        String   @default("{}")
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TryOnSession {
  id           String   @id @default(cuid())
  userId       String
  designId     String?
  photoUrl     String
  resultUrl    String?
  reviewJson   String   @default("{}")
  status       String   @default("created")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design       Design?  @relation(fields: [designId], references: [id])
}

model AiJob {
  id         String      @id @default(cuid())
  type       AiJobType
  status     AiJobStatus @default(QUEUED)
  inputJson  String      @default("{}")
  outputJson String      @default("{}")
  provider   String      @default("mock")
  error      String?
  latencyMs  Int?
  createdAt  DateTime    @default(now())
  finishedAt DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  href      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metaJson  String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}
