# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Capacitor / Android build outputs (keep android/ project sources)
/android/app/build/
/android/.gradle/
/android/local.properties
/android/captures/
*.apk
*.aab
*.ap_

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets / keys
*.pem
*.key
*credentials*.json
service-account*.json
secrets/
.secrets/

# local database
/prisma/*.db
/prisma/*.db-journal
/prisma/ci.db

# IDE caches (keep shared project metadata if intentionally tracked)
.idea/caches/
.idea/libraries/
.idea/shelf/

# user uploads
/public/uploads/**
!/public/uploads/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
